# Python: bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Jupyter / IPython temporary files
.ipynb_checkpoints/
.ipython/

# Matplotlib local cache and configuration
.matplotlib/

# Local environment variables and secrets
.env
.env.*
!.env.example
!.env.sample

# Immutable source data stored locally
/data/raw/*
!/data/raw/.gitkeep
!/data/raw/README.md

# Reproducible datasets generated by the cleaning pipeline
/data/processed/*
!/data/processed/.gitkeep
!/data/processed/README.md

# Local analytical databases and their temporary files
/data/**/*.db
/data/**/*.sqlite
/data/**/*.sqlite3
/data/**/*.duckdb
/data/**/*.db-journal
/data/**/*.db-wal
/data/**/*.db-shm
/data/**/*.sqlite-journal
/data/**/*.sqlite-wal
/data/**/*.sqlite-shm
/data/**/*.sqlite3-journal
/data/**/*.sqlite3-wal
/data/**/*.sqlite3-shm
/data/**/*.duckdb.wal

# Notebooks, SQL scripts, dashboards and reports are project deliverables.
# Keep them under version control, including exported figures and reports.

# Operating system files
.DS_Store
Thumbs.db

# Editor temporary files
*.swp
*.swo
*~
